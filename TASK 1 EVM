#include <SPI.h>
#include <Adafruit_GFX.h>
#include <Adafruit_ILI9341.h>
#include <Keypad.h>

// ================= TFT =================
#define TFT_CS  53
#define TFT_DC  49
#define TFT_RST 48

Adafruit_ILI9341 tft(TFT_CS, TFT_DC, TFT_RST);

// ================= BUTTONS =================
const byte partyPins[4] = {30, 31, 32, 33};
const byte confirmPin = 34;

// ================= LEDS =================
const byte ledPins[4] = {35, 36, 37, 38};

// ================= PARTY NAMES =================
const char* partyNames[4] = {
  "BJP", "CONGRESS", "JD(S)", "AAP"
};

// ================= KEYPAD =================
const byte ROWS = 4;
const byte COLS = 4;

char keys[ROWS][COLS] = {
  {'1','2','3','A'},
  {'4','5','6','B'},
  {'7','8','9','C'},
  {'*','0','#','D'}
};

byte rowPins[ROWS] = {22, 23, 24, 25};
byte colPins[COLS] = {26, 27, 28, 29};

Keypad keypad = Keypad(
  makeKeymap(keys), rowPins, colPins, ROWS, COLS
);

// ================= VOTES =================
unsigned long votes[4] = {0, 0, 0, 0};
unsigned long totalVotes = 0;

const char officerPassword[] = "1969";
String passwordEntry = "";

int selectedParty = -1;

enum ScreenMode {
  VOTING,
  SHOWING_PARTY,
  COMPLETED,
  RESULTS
};

ScreenMode mode = VOTING;

unsigned long partyStart = 0;
const unsigned long PARTY_TIME = 4000;

bool voteRecorded = false;

bool previousParty[4] = {HIGH, HIGH, HIGH, HIGH};
bool previousConfirm = HIGH;

// ================= OPENING SCREEN =================
void showOpening() {
  tft.fillScreen(ILI9341_BLACK);
  tft.setTextColor(ILI9341_CYAN);
  tft.setTextSize(3);
  tft.setCursor(10, 40);
  tft.println("ELECTRONIC");
  tft.setCursor(10, 85);
  tft.println("VOTING");
  tft.setCursor(10, 130);
  tft.println("MACHINE");

  tft.setTextColor(ILI9341_WHITE);
  tft.setTextSize(1);
  tft.setCursor(10, 200);
  tft.println("DEMONSTRATION PROJECT");
  delay(2000);
}

// ================= PARTY SYMBOLS =================
// Simplified drawings, not exact official emblems.
void drawPartySymbol(int party, int cx, int cy) {
  if (party == 0) {
    // BJP: simplified lotus
    uint16_t c = ILI9341_ORANGE;

    tft.fillTriangle(cx, cy - 35,
                     cx - 12, cy - 8,
                     cx + 12, cy - 8, c);

    tft.fillTriangle(cx - 25, cy - 25,
                     cx - 10, cy - 5,
                     cx, cy + 8, c);

    tft.fillTriangle(cx + 25, cy - 25,
                     cx + 10, cy - 5,
                     cx, cy + 8, c);

    tft.fillTriangle(cx - 20, cy + 5,
                     cx + 20, cy + 5,
                     cx, cy + 20, c);

    tft.drawLine(cx, cy + 17,
                 cx, cy + 35, ILI9341_GREEN);

  } else if (party == 1) {
    // Congress: simplified open hand
    uint16_t c = ILI9341_WHITE;

    tft.fillRoundRect(cx - 17, cy - 5,
                      34, 35, 8, c);

    tft.fillRoundRect(cx - 19, cy - 35,
                      8, 39, 4, c);

    tft.fillRoundRect(cx - 9, cy - 43,
                      8, 47, 4, c);

    tft.fillRoundRect(cx + 1, cy - 40,
                      8, 44, 4, c);

    tft.fillRoundRect(cx + 11, cy - 30,
                      8, 34, 4, c);

    tft.fillRoundRect(cx - 29, cy + 1,
                      13, 8, 4, c);

  } else if (party == 2) {
    // JD(S): simplified farmer and paddy
    uint16_t c = ILI9341_YELLOW;

    tft.fillCircle(cx, cy - 20, 10, c);

    tft.drawLine(cx, cy - 10,
                 cx, cy + 18, ILI9341_WHITE);

    tft.drawLine(cx, cy - 2,
                 cx - 22, cy + 10, ILI9341_WHITE);

    tft.drawLine(cx, cy - 2,
                 cx + 22, cy + 8, ILI9341_WHITE);

    tft.drawLine(cx, cy + 18,
                 cx - 13, cy + 34, ILI9341_WHITE);

    tft.drawLine(cx, cy + 18,
                 cx + 13, cy + 34, ILI9341_WHITE);

    tft.drawLine(cx + 27, cy + 18,
                 cx + 27, cy - 30, ILI9341_GREEN);

    for (int j = 0; j < 4; j++) {
      tft.drawLine(cx + 27, cy - 25 + j * 9,
                   cx + 37, cy - 30 + j * 9, c);
    }

  } else {
    // AAP: simplified broom
    uint16_t c = ILI9341_YELLOW;

    tft.drawLine(cx - 20, cy + 30,
                 cx + 18, cy - 28, ILI9341_WHITE);

    for (int j = 0; j < 5; j++) {
      tft.drawLine(cx - 29 + j * 4, cy + 23 - j * 4,
                   cx - 11 + j * 4, cy + 35 - j * 4, c);
    }
  }
}

// ================= PARTY MENU =================
void showMenu() {
  mode = VOTING;

  tft.fillScreen(ILI9341_BLACK);
  tft.setTextColor(ILI9341_CYAN);
  tft.setTextSize(2);
  tft.setCursor(8, 8);
  tft.println("ELECTRONIC VOTING");
  tft.drawFastHLine(5, 35, 310, ILI9341_WHITE);

  tft.setTextColor(ILI9341_WHITE);
  tft.setCursor(10, 48);
  tft.println("Select your party:");

  for (int i = 0; i < 4; i++) {
    tft.setCursor(15, 80 + i * 30);
    tft.setTextColor(
      selectedParty == i ? ILI9341_GREEN : ILI9341_YELLOW
    );

    if (selectedParty == i) tft.print("> ");
    else tft.print("  ");

    tft.println(partyNames[i]);
  }

  tft.setTextSize(1);
  tft.setTextColor(ILI9341_WHITE);
  tft.setCursor(10, 210);

  if (selectedParty >= 0) {
    tft.print("Selected: ");
    tft.println(partyNames[selectedParty]);

    tft.setCursor(10, 228);
    tft.println("Press CONFIRM to vote");
  } else {
    tft.println("Press a party button");
  }
}

// ================= LARGE PARTY DISPLAY =================
void showParty(int party) {
  mode = SHOWING_PARTY;
  partyStart = millis();

  tft.fillScreen(ILI9341_BLACK);

  tft.setTextColor(ILI9341_CYAN);
  tft.setTextSize(2);
  tft.setCursor(15, 15);
  tft.println("PARTY SELECTED");

  tft.setTextColor(ILI9341_GREEN);

  // Use smaller text for the long CONGRESS name.
  if (party == 1) {
    tft.setTextSize(3);
    tft.setCursor(20, 55);
  } else {
    tft.setTextSize(4);
    tft.setCursor(15, 55);
  }

  tft.println(partyNames[party]);

  drawPartySymbol(party, 160, 145);

  tft.setTextColor(ILI9341_WHITE);
  tft.setTextSize(2);
  tft.setCursor(55, 210);
  tft.println("Please wait...");
}

// ================= VOTING COMPLETED =================
void showCompleted() {
  mode = COMPLETED;
  passwordEntry = "";

  tft.fillScreen(ILI9341_BLACK);
  tft.setTextColor(ILI9341_GREEN);
  tft.setTextSize(2);
  tft.setCursor(10, 35);
  tft.println("VOTING COMPLETED");

  tft.setTextColor(ILI9341_WHITE);
  tft.setCursor(10, 85);
  tft.println("Thank you!");

  tft.setTextSize(1);
  tft.setCursor(10, 145);
  tft.println("Officer: enter password");
  tft.setCursor(10, 165);
  tft.println("Press # to view results");
  tft.setCursor(10, 200);
  tft.println("Next voter: press CONFIRM");

  // Never print the password or typed digits.
}

// ================= ACCESS DENIED =================
void accessDenied() {
  tft.fillScreen(ILI9341_BLACK);
  tft.setTextColor(ILI9341_RED);
  tft.setTextSize(3);
  tft.setCursor(20, 100);
  tft.println("ACCESS DENIED");

  delay(1200);
  passwordEntry = "";
  showCompleted();
}

// ================= RESULTS =================
void showResults() {
  mode = RESULTS;
  passwordEntry = "";

  tft.fillScreen(ILI9341_BLACK);
  tft.setTextColor(ILI9341_CYAN);
  tft.setTextSize(2);
  tft.setCursor(8, 8);
  tft.println("VOTING RESULTS");

  tft.setTextColor(ILI9341_WHITE);
  tft.setCursor(10, 38);
  tft.print("Total: ");
  tft.println(totalVotes);

  for (int i = 0; i < 4; i++) {
    tft.setTextColor(ILI9341_YELLOW);
    tft.setCursor(10, 70 + i * 28);
    tft.print(partyNames[i]);
    tft.print(": ");
    tft.println(votes[i]);
  }

  unsigned long highest = 0;

  for (int i = 0; i < 4; i++) {
    if (votes[i] > highest) highest = votes[i];
  }

  int leaders = 0;

  for (int i = 0; i < 4; i++) {
    if (votes[i] == highest) leaders++;
  }

  tft.setTextColor(ILI9341_GREEN);
  tft.setCursor(10, 190);

  if (totalVotes == 0) {
    tft.println("No votes yet");
  } else if (leaders > 1) {
    tft.println("RESULT: TIE");
  } else {
    for (int i = 0; i < 4; i++) {
      if (votes[i] == highest) {
        tft.println(partyNames[i]);
        break;
      }
    }
  }

  tft.setTextSize(1);
  tft.setTextColor(ILI9341_WHITE);
  tft.setCursor(10, 225);
  tft.println("* = return to voting");
}

// ================= CAST EXACTLY ONE VOTE =================
void castVote() {
  if (selectedParty < 0 || voteRecorded) return;

  voteRecorded = true;
  votes[selectedParty]++;
  totalVotes++;

  digitalWrite(ledPins[selectedParty], HIGH);
  delay(300);
  digitalWrite(ledPins[selectedParty], LOW);

  showCompleted();
}

// ================= KEYPAD =================
void handleKeypad() {
  char key = keypad.getKey();

  if (key == NO_KEY) return;

  if (mode == RESULTS) {
    if (key == '*') {
      selectedParty = -1;
      voteRecorded = false;
      showMenu();
    }
    return;
  }

  if (mode != COMPLETED) return;

  if (key >= '0' && key <= '9') {
    if (passwordEntry.length() < 6) {
      passwordEntry += key;
      // Password is intentionally hidden.
    }
  } else if (key == '*') {
    passwordEntry = "";
  } else if (key == '#') {
    if (passwordEntry == officerPassword) {
      showResults();
    } else {
      accessDenied();
    }
  }
}

// ================= SETUP =================
void setup() {
  Serial.begin(9600);

  for (int i = 0; i < 4; i++) {
    pinMode(partyPins[i], INPUT_PULLUP);
    pinMode(ledPins[i], OUTPUT);
    digitalWrite(ledPins[i], LOW);
  }

  pinMode(confirmPin, INPUT_PULLUP);

  tft.begin();
  tft.setRotation(1);  // 320 x 240 landscape

  showOpening();
  showMenu();
}

// ================= MAIN LOOP =================
void loop() {
  handleKeypad();

  // Party name and symbol remain for 4 seconds.
  if (mode == SHOWING_PARTY &&
      millis() - partyStart >= PARTY_TIME) {
    showMenu();
  }

  // Party-selection buttons
  if (mode == VOTING) {
    for (int i = 0; i < 4; i++) {
      bool current = digitalRead(partyPins[i]);

      if (previousParty[i] == HIGH && current == LOW) {
        delay(25);

        if (digitalRead(partyPins[i]) == LOW) {
          selectedParty = i;
          showParty(i);
        }
      }

      previousParty[i] = current;
    }
  } else {
    for (int i = 0; i < 4; i++) {
      previousParty[i] = digitalRead(partyPins[i]);
    }
  }

  // Confirmation button
  bool currentConfirm = digitalRead(confirmPin);

  if (previousConfirm == HIGH && currentConfirm == LOW) {
    delay(25);

    if (digitalRead(confirmPin) == LOW) {
      if (mode == VOTING) {
        castVote();
      } else if (mode == COMPLETED) {
        // Start a new demonstration voting session.
        selectedParty = -1;
        voteRecorded = false;
        showMenu();
      }
    }
  }

  previousConfirm = currentConfirm;
}
